# =================================================================
# MITS STUDENT PLACEMENT MANAGEMENT PORTAL - ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port & Runtime
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=your_mongodb_connection_string

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application URL (for reset & verification links)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Officer Setup Bootstrap Token (one-time setup for authorized officers)
OFFICER_SETUP_TOKEN=placement_admin_2026

# =================================================================
# CENTRALIZED INSTITUTIONAL EMAIL CONFIGURATION (MITS)
# =================================================================
# All automated emails (verification, forgot password, application status,
# drive announcements, selection offers) use this central sender.
# Officers log in independently and do NOT require personal email configs.

FROM_NAME="MITS Placement Cell"
FROM_EMAIL="placement-portal@mits.ac.in"

# -----------------------------------------------------------------
# OPTION 1: Microsoft 365 Modern OAuth 2.0 (Recommended for MITS Outlook)
# Many institutions enforce OAuth2 and disable Basic SMTP AUTH.
# Register an Azure AD / Entra ID App in the college tenant:
# -----------------------------------------------------------------
# EMAIL_USER=placement-portal@mits.ac.in
# M365_CLIENT_ID=your_azure_ad_application_client_id
# M365_CLIENT_SECRET=your_azure_ad_client_secret
# M365_TENANT_ID=your_m365_tenant_id_or_common
# M365_REFRESH_TOKEN=your_oauth_refresh_token

# -----------------------------------------------------------------
# OPTION 2: Standard MITS / Office 365 SMTP Relay
# If MITS allows authenticated SMTP client submission on port 587:
# -----------------------------------------------------------------
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=placement-portal@mits.ac.in
# EMAIL_PASSWORD=your_authorized_smtp_password

# -----------------------------------------------------------------
# OPTION 3: Alternative Approved Email Relay (Gmail / Brevo / SendGrid)
# Supported if institutional direct sending requires administrative clearance:
# -----------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=mitsplacements2026@gmail.com
# EMAIL_PASSWORD=your_16_char_google_app_password
